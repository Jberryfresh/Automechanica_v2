# RabbitMQ Configuration
RABBITMQ_URL=amqp://app:changeme@localhost:5672/
ORCH_EXCHANGE=app.commands
WORKER_QUEUE=app.worker.sourcing
ROUTING_KEY=sourcing.request

# Database
DATABASE_URL=postgres://app:changeme@localhost:5432/appdb

# OpenAI API (REQUIRED for AI agents)
OPENAI_API_KEY=sk-...

# Orchestrator Service
PORT=3000

# Shopify Integration (add when testing Shopify flows)
SHOPIFY_SHOP=my-store.myshopify.com
SHOPIFY_API_KEY=your_api_key
SHOPIFY_API_SECRET=your_api_secret
SHOPIFY_ACCESS_TOKEN=your_access_token

# Thresholds for human checkpoints
LARGE_ORDER_THRESHOLD=500
HUMAN_CHECK_TTL_HOURS=24
